# Chave da API da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Modelo padrão do Claude — opcional, cai em claude-sonnet-5 se não setado
CLAUDE_MODEL=claude-sonnet-5

# Chave da API da OpenAI — só fase de teste, GPT Image sai depois pro Higsfield SLM
OPENAI_API_KEY=
GPT_IMAGE_MODEL=gpt-image-1

# Conexão com o Postgres local (do docker-compose)
DATABASE_URL=postgresql://sollun:sollun_dev@localhost:5432/sollun
